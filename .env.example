# Porta da API na sua maquina
PORT=3000

# PostgreSQL do Railway: copie os dados da DATABASE_PUBLIC_URL.
# Enderecos *.railway.internal nao funcionam no Docker local.
DB_HOST=seu-host-publico.proxy.rlwy.net
# Substitua pela porta publica do Railway; 12345 e apenas um exemplo.
DB_PORT=12345
DB_USERNAME=postgres
DB_PASSWORD=substitua-pela-senha-do-banco
DB_DATABASE=railway
DB_SSL=true
DB_SSL_CA_FILE=./certs/railway-root.crt